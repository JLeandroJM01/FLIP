# Copiar a .env.local y completar. Nunca versionar .env.local.

# Supabase (Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=        # Publishable key (sb_publishable_...)
SUPABASE_SERVICE_ROLE_KEY=            # Secret key (sb_secret_...) — solo en el servidor

# Único correo que puede entrar
ALLOWED_EMAIL=

# Google OAuth (Google Cloud → Google Auth Platform → Clients); usado por Supabase local
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Fase 2: firma HMAC del Apps Script (openssl rand -hex 32)
INGEST_SECRET=

# Fase 4 (opcional): clasificación con Claude
# ANTHROPIC_API_KEY=
